# ---- LLM PROVIDER KEYS (add whichever you have, at least one required) ----
# Free tier — get at: aistudio.google.com
GEMINI_API_KEY=

# Free tier — get at: console.groq.com
GROQ_API_KEY=

# Free tier ($1 credit) — get at: api.together.ai
TOGETHER_API_KEY=

# Free tier ($1 credit) — get at: openrouter.ai
OPENROUTER_API_KEY=

# Paid — get at: console.anthropic.com
ANTHROPIC_API_KEY=

# Paid — get at: platform.openai.com
OPENAI_API_KEY=

# Which provider to prefer (optional — router auto-detects if not set)
# Options: gemini | groq | together | openrouter | anthropic | openai
LLM_PREFERRED_PROVIDER=

# ---- EXTERNAL API KEYS ----
ASTROLOGY_API_KEY=
GEOCODING_API_KEY=

# ---- INFRASTRUCTURE ----
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql+asyncpg://vedic:vedic@postgres:5432/vedic

# ---- APP CONFIG ----
API_KEY=your-secret-api-key
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]
EPHE_PATH=/app/ephe
